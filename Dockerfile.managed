ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
FROM ${PYTHON_IMAGE} AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11.8@sha256:3b7b60a81d3c57ef471703e5c83fd4aaa33abcd403596fb22ab07db85ae91347 /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      SSL_CERT_FILE=/run/secrets/proxy_ca uv sync --locked --no-dev --no-editable; \
    else uv sync --locked --no-dev --no-editable; fi

FROM caddy@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f AS gateway
FROM ${PYTHON_IMAGE} AS managed
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH" RADAR_MODE=standby RADAR_STATE_ROOT=/app/data/state \
    XDG_CONFIG_HOME=/tmp/caddy/config XDG_DATA_HOME=/tmp/caddy/data
WORKDIR /app
RUN groupadd --gid 10001 radar && useradd --uid 10001 --gid 10001 --no-create-home radar \
    && mkdir -p /app/data && chown 10001:10001 /app/data
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --from=gateway /usr/bin/caddy /usr/local/bin/caddy
# This gateway listens above 1024; inherited bind capabilities conflict with
# cap-drop ALL / no-new-privileges and are unnecessary for the managed service.
RUN python -c "import os; p='/usr/local/bin/caddy'; os.removexattr(p, 'security.capability') if 'security.capability' in os.listxattr(p) else None"
COPY --chown=10001:10001 scripts/cloud_runtime.py scripts/managed_runtime.py scripts/migrate_state.py ./scripts/
USER 10001:10001
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','10000')+'/healthz',timeout=4).close()"
ENTRYPOINT ["python", "-m", "scripts.managed_runtime"]
