# Local secret file: copy to .env.cloud on the server; never commit it.
RADAR_IMAGE=immortal-trading:lot103
RADAR_DATA_DIR=/srv/immortal-trading/data
# Set true only after the old Windows watcher and Telegram listener have stopped.
RADAR_CUTOVER_CONFIRMED=false
ALERTS_ENABLED=false
TELEGRAM_CONTROL_ENABLED=false
TELEGRAM_INCIDENT_NOTICES_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
